{
  "name": "hokoo/templater",
  "description": "Keep your templates in one place apart from your php code.",
  "minimum-stability": "stable",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "Igor Tron",
      "email": "root@itron.pro"
    }
  ],
  "autoload": {
    "psr-4": {
      "iTRON\\Anatomy\\": "src/",
      "iTRON\\Templater\\": "legacy/"
    }
  },
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6.33"
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "coverage": "php dev/check-coverage.php",
    "test": "phpunit"
  }
}
